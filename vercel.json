{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "redirects": [
    { "source": "/", "destination": "/selkey", "permanent": true },
    { "source": "/:base(agentvault|selkey)/a2a-and-agentvault{/}?", "destination": "/selkey/a2a-and-selkey/", "permanent": true },
    { "source": "/:base(agentvault|selkey)/integrating-agentvault{/}?", "destination": "/selkey/integrating-selkey/", "permanent": true },
    { "source": "/:base(agentvault|selkey)/understanding-agentvault-guarantees{/}?", "destination": "/selkey/understanding-selkey-guarantees/", "permanent": true },
    { "source": "/agentvault", "destination": "/selkey", "permanent": true },
    { "source": "/agentvault/:path(.*)", "destination": "/selkey/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/selkey", "destination": "/index.html" },
    { "source": "/selkey/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
